.obsidian/workspace*
.obsidian/cache

# obsidian UI state — written constantly as operator interacts with UI
# (pan/zoom/filter on graph, theme toggles, layout state)
# See _runbooks/Runbook-Obsidian-Workspace-Drift.md
.obsidian/graph.json
.obsidian/app.json
.obsidian/appearance.json
.trash/

# obsidian local rest api: contains API key + private RSA — never commit
.obsidian/plugins/obsidian-local-rest-api/

# python bytecode
__pycache__/
*.pyc

# common os/editor noise
.DS_Store
Thumbs.db

# firm-bus control-plane local state (per-machine, do NOT push)
# See _decisions/2026-05-14-control-plane-proposal.md (risiko 2 + 3)
00-firm-bus/pane-status/*
!00-firm-bus/pane-status/.gitkeep
00-firm-bus/git-snapshot.json
